@@ -146,6 +149,37 @@ int main(int argc, char *argv[])
       }
    }
 
+#ifdef ANDROID
+   /* allow a frontend to pass the pak via intent extra "pak" (am start -n org.openbor.engine/.GameActivity -e pak /path.pak) */
+   if(!romArg) {
+      JNIEnv *env = (JNIEnv *)SDL_AndroidGetJNIEnv();
+      jobject activity = (jobject)SDL_AndroidGetActivity();
+      if(env && activity) {
+         jclass acls = (*env)->GetObjectClass(env, activity);
+         jmethodID mGetIntent = (*env)->GetMethodID(env, acls, "getIntent", "()Landroid/content/Intent;");
+         jobject intent = mGetIntent ? (*env)->CallObjectMethod(env, activity, mGetIntent) : NULL;
+         if(intent) {
+            jclass icls = (*env)->GetObjectClass(env, intent);
+            jmethodID mGet = (*env)->GetMethodID(env, icls, "getStringExtra", "(Ljava/lang/String;)Ljava/lang/String;");
+            jstring key = (*env)->NewStringUTF(env, "pak");
+            jstring val = mGet ? (jstring)(*env)->CallObjectMethod(env, intent, mGet, key) : NULL;
+            if(val) {
+               const char *cs = (*env)->GetStringUTFChars(env, val, NULL);
+               if(cs && strlen(cs) < sizeof(packfile)) {
+                  strcpy(packfile, cs);
+                  if(fileExists(packfile)) romArg = 1;
+                  printf("Intent pak extra: %s (%s)\n", packfile, romArg ? "found" : "NOT FOUND");
+               }
+               if(cs) (*env)->ReleaseStringUTFChars(env, val, cs);
+               (*env)->DeleteLocalRef(env, val);
+            }
+            (*env)->DeleteLocalRef(env, key); (*env)->DeleteLocalRef(env, icls); (*env)->DeleteLocalRef(env, intent);
+         }
+         (*env)->DeleteLocalRef(env, acls); (*env)->DeleteLocalRef(env, activity);
+      }
+   }
+#endif
+
    if(!romArg) {
        Menu();
    }
